cabal-version:       2.4
name:                haspot
version:             0.2.0.0
synopsis:            A static blog generator built on Hakyll
description:
  Haspot turns Markdown posts under @posts/@ into a static blog with
  pagination, an archive page, an Atom feed, a sitemap and MathJax support.
  Site-wide settings live in @conf/setting.yml@.
homepage:            https://github.com/MnO2/haspot
bug-reports:         https://github.com/MnO2/haspot/issues
license:             MIT
license-file:        LICENSE
author:              Paul Meng
maintainer:          mno2@mno2.org
copyright:           2015 Paul Meng
category:            Web
build-type:          Simple
extra-doc-files:     README.md
                     CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/MnO2/haspot.git

executable haspot
  main-is:             haspot.hs
  default-language:    Haskell2010
  ghc-options:         -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:       base   >= 4.14 && < 5
                     , hakyll >= 4.16 && < 4.18
                     , pandoc >= 3.0
                     , time   >= 1.9
                     , yaml   >= 0.11
